{
  "ConnectionMSSQL": {
    "ConnectionString": "Data Source=localhost,1433;Initial Catalog=ProjetoBiblioteca;User Id=sa;Password=${Password_Database};TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    "Subject": "Default Subject",
    "Message": "This is the default message from the API",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "${EMAIL_USERNAME}",
    "Password": "${EMAIL_PASSWORD}",
    "Properties": {
      "SmtpAuth": "true",
      "StartTlsEnable": "true",
      "StartTlsRequired": "true"
    },
    "Ssl": true
  },
  "TokenConfiguration": {
    "Audience": "ExempleAudience",
    "Issuer": "ExampleIssuer",
    "Secret": "THIS_IS_GUSTAVO_SUPER_SUPER_SECRET_KEY_KEY",
    "Minutes": 60,
    "DaysToExpiry": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "ProjetoBiblioteca": "Debug"
      }

    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]

  },
  "AllowedHosts": "*"
}
