{
  "ConnectionMSSQL": {
    "ConnectionString": "Data Source=localhost,1433;Initial Catalog=ProjetoBiblioteca;User Id=sa;Password=${Password_Database};TrustServerCertificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "ProjetoBiblioteca": "Debug"
      }

    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
    
  },
  "AllowedHosts": "*"
}
